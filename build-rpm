#!/bin/bash
# build-rpm — Build FreeCast RPM package
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Configuration — match your project
APP_NAME="freecast"
DISPLAY_NAME="FreeCast"
VERSION="1.0.0"
RELEASE="1"
MAINTAINER="Koosha Yeganeh <kooshakooshadv@gmail.com>"
DESCRIPTION="Video Hosting Platform - Convert your old PC into a media server"
URL="https://github.com/KooshaYeganeh/FMhost"
LICENSE="MIT"

RPMBUILD="$HOME/rpmbuild"
SPEC_DIR="$RPMBUILD/SPECS"
SOURCE_DIR="$RPMBUILD/SOURCES"

echo -e "${YELLOW}Preparing RPM build tree...${NC}"
mkdir -p "$RPMBUILD"/{BUILD,RPMS,SOURCES,SPECS,SRPMS}

# ---------- Create source tarball ----------
echo -e "${YELLOW}Creating source tarball...${NC}"
TARBALL_NAME="${APP_NAME}-${VERSION}"
TMP_DIR=$(mktemp -d)
mkdir -p "$TMP_DIR/$TARBALL_NAME"

# app/ already contains static/ and templates/ inside it — copy as one unit
cp -r app              "$TMP_DIR/$TARBALL_NAME/"
cp    requirements.txt "$TMP_DIR/$TARBALL_NAME/"
cp    README.md        "$TMP_DIR/$TARBALL_NAME/"
cp    LICENSE          "$TMP_DIR/$TARBALL_NAME/"
cp    FMhost.service   "$TMP_DIR/$TARBALL_NAME/"
cp    FMhost_runner    "$TMP_DIR/$TARBALL_NAME/"

# Optional extras — don't fail if missing
[ -d Documents ] && cp -r Documents "$TMP_DIR/$TARBALL_NAME/"
[ -d dbconf ]    && cp -r dbconf    "$TMP_DIR/$TARBALL_NAME/" || true

# Screenshots are nice for docs but optional
[ -d Screenshot ] && cp -r Screenshot "$TMP_DIR/$TARBALL_NAME/" || true

# Never ship venv/build/.git
rm -rf "$TMP_DIR/$TARBALL_NAME/venv" 2>/dev/null || true
rm -rf "$TMP_DIR/$TARBALL_NAME/build" 2>/dev/null || true

tar -czf "$SOURCE_DIR/${TARBALL_NAME}.tar.gz" -C "$TMP_DIR" "$TARBALL_NAME"
rm -rf "$TMP_DIR"

# ---------- Write spec ----------
echo -e "${YELLOW}Writing spec file...${NC}"
cat > "$SPEC_DIR/${APP_NAME}.spec" << SPEC_EOF
Name:           ${APP_NAME}
Version:        ${VERSION}
Release:        ${RELEASE}%{?dist}
Summary:        ${DESCRIPTION}

License:        ${LICENSE}
URL:            ${URL}
Source0:        %{name}-%{version}.tar.gz
Vendor:         Koosha Yeganeh
BuildArch:      x86_64

Requires:       python3 >= 3.11
Requires:       python3-pip
Requires:       python3-virtualenv
Requires:       mariadb-server
Requires:       nginx
Requires:       ffmpeg

%description
${DISPLAY_NAME} is a self-hosted video streaming platform that converts any
old PC into a fully functional media server. It features video uploading,
organization, streaming, and management through a web interface.

%prep
%setup -q

%build
# Pure Python — nothing to compile

%install
rm -rf %{buildroot}

# Main app directory — app/ already contains static/ and templates/
mkdir -p %{buildroot}/opt/%{name}
cp -r app              %{buildroot}/opt/%{name}/
cp    requirements.txt %{buildroot}/opt/%{name}/
cp    README.md        %{buildroot}/opt/%{name}/
cp    LICENSE          %{buildroot}/opt/%{name}/

# systemd unit
mkdir -p %{buildroot}/usr/lib/systemd/system
sed 's|/home/koosha/w/FMhost|/opt/%{name}|g; s|/opt/fmhost|/opt/%{name}|g' FMhost.service \\
    > %{buildroot}/usr/lib/systemd/system/%{name}.service

# Runner script
mkdir -p %{buildroot}/usr/local/bin
sed -e 's|/home/\$USER/w/FMhost|/opt/%{name}|g' \\
    -e 's|/opt/fmhost|/opt/%{name}|g' \\
    -e 's|cd app|cd /opt/%{name}/app|g' FMhost_runner \\
    > %{buildroot}/usr/local/bin/%{name}-runner
chmod 0755 %{buildroot}/usr/local/bin/%{name}-runner

# Nginx config
mkdir -p %{buildroot}/etc/nginx/conf.d
cat > %{buildroot}/etc/nginx/conf.d/%{name}.conf << 'NGINX'
server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:5005;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location /static {
        alias /opt/%{name}/app/static;
        expires 30d;
    }
}
NGINX

# Docs
mkdir -p %{buildroot}/usr/share/doc/%{name}
cp README.md %{buildroot}/usr/share/doc/%{name}/README.RPM

%post
mkdir -p /var/log/%{name}
mkdir -p /var/lib/%{name}/media
mkdir -p /var/lib/%{name}/covers
mkdir -p /var/lib/%{name}/thumbnails

if ! id -u %{name} >/dev/null 2>&1; then
    useradd -r -s /bin/bash -m -d /opt/%{name} %{name}
fi

chown -R %{name}:%{name} /opt/%{name}
chown -R %{name}:%{name} /var/log/%{name}
chown -R %{name}:%{name} /var/lib/%{name}

echo "Setting up Python virtual environment..."
cd /opt/%{name}
if [ ! -d venv ]; then
    python3 -m venv venv
fi
source venv/bin/activate
pip install --upgrade pip
pip install -r requirements.txt
deactivate

if command -v mysql &>/dev/null; then
    mysql -e "CREATE DATABASE IF NOT EXISTS kygnus_video_library;" || true
    mysql -e "CREATE USER IF NOT EXISTS 'koosha'@'localhost' IDENTIFIED BY 'K102030k';" || true
    mysql -e "GRANT ALL PRIVILEGES ON kygnus_video_library.* TO 'koosha'@'localhost';" || true
    mysql -e "FLUSH PRIVILEGES;" || true
fi

systemctl daemon-reload
systemctl enable %{name}.service || true
systemctl start  %{name}.service || true

if command -v nginx &>/dev/null; then
    nginx -t && systemctl reload nginx || true
fi

echo "${DISPLAY_NAME} installed. Access at http://\$(hostname -I | awk '{print \$1}'):5005"

%preun
if [ "\$1" -eq 0 ]; then
    systemctl stop    %{name}.service || true
    systemctl disable %{name}.service || true
fi

%postun
if [ "\$1" -eq 0 ]; then
    rm -f /etc/nginx/conf.d/%{name}.conf

    if id -u %{name} >/dev/null 2>&1; then
        userdel %{name} 2>/dev/null || true
    fi

    rmdir /var/log/%{name} 2>/dev/null || true
    rmdir /var/lib/%{name} 2>/dev/null || true

    if command -v nginx &>/dev/null; then
        nginx -t && systemctl reload nginx 2>/dev/null || true
    fi

    systemctl daemon-reload || true
fi

%files
%config(noreplace) /etc/nginx/conf.d/%{name}.conf
/usr/lib/systemd/system/%{name}.service
/usr/local/bin/%{name}-runner
/opt/%{name}
/usr/share/doc/%{name}/README.RPM

%changelog
* $(date "+%a %b %d %Y") Koosha Yeganeh <kooshakooshadv@gmail.com> - ${VERSION}-${RELEASE}
- Initial RPM release of ${DISPLAY_NAME}
SPEC_EOF

# ---------- Build ----------
echo -e "${YELLOW}Building RPM...${NC}"
rpmbuild -bb "$SPEC_DIR/${APP_NAME}.spec"

RPM_FILE=$(find "$RPMBUILD/RPMS" -name "${APP_NAME}-${VERSION}-${RELEASE}*.rpm" | head -n1)

if [ -n "$RPM_FILE" ]; then
    cp "$RPM_FILE" .
    echo -e "${GREEN}✅ RPM created: $(basename "$RPM_FILE")${NC}"
    echo ""
    echo -e "${YELLOW}To install:${NC}"
    echo "  sudo dnf install ./$(basename "$RPM_FILE")"
    echo "  sudo zypper install ./$(basename "$RPM_FILE")"
    echo ""
    echo -e "${YELLOW}To remove:${NC}"
    echo "  sudo dnf remove freecast"
    echo "  sudo zypper remove freecast"
else
    echo -e "${RED}❌ RPM build failed.${NC}"
    exit 1
fi
